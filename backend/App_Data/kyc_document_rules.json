{
  "_meta": {
    "version": "1.0.0",
    "description": "EduVora KYC Document Validation Rules for Backend Basic Validator.",
    "lastUpdated": "2026-08-30",
    "supportedDocumentTypes": [
      "1",
      "2",
      "3",
      "4",
      "5"
    ]
  },
  "globalFileRules": {
    "maxFileSizeBytes": 5242880,
    "maxFileSizeMB": 5,
    "minFileSizeBytes": 5120,
    "minFileSizeKB": 5
  },
  "documents": {
    "1": {
      "name": "Aadhar Card"
    },
    "2": {
      "name": "Passport"
    },
    "3": {
      "name": "Driving License"
    },
    "4": {
      "name": "Voter ID"
    },
    "5": {
      "name": "PAN Card",
      "numberField": {
        "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$"
      }
    }
  }
}