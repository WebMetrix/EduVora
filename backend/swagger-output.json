    "/kyc/": {
      "get": {
        "tags": [
          "KYC"
        ],
        "summary": "Check Live KYC Status",
        "description": "Fetches the current KYC status of the logged-in user from the database.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
