# ============================================================
# EduVora Audiobook Worker Service Configuration
# ============================================================

# RabbitMQ Broker URL
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
CELERY_QUEUE=chapter_audio_jobs
CELERY_CONCURRENCY=4

# Microsoft SQL Server Connection String (ODBC Driver 17 or 18)
SQLSERVER_CONN_STR=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=QADevEduvora;UID=sa;PWD=YourStrongPassword;TrustServerCertificate=yes;

# LLM Provider for Teacher-Style Script Generation ("gemini" or "openai")
LLM_PROVIDER=gemini

# Google Gemini Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Settings (used if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Text-to-Speech (edge-tts) Settings
# Popular voices: en-IN-NeerjaNeural, en-IN-PrabhatNeural, en-US-AndrewNeural, en-GB-SoniaNeural
TTS_VOICE=en-IN-NeerjaNeural
TTS_RATE=+0%

# Branding & Watermark Spoken Cues
AUDIO_INTRO_LINE=Welcome to Eduvora.
AUDIO_OUTRO_LINE=Thanks for hearing.
AUDIO_WATERMARK_PHRASE=EduVora. Learn, Grow, Earn.

# Paths (relative paths are resolved automatically against the project root)
COVER_ART_PATH=assets/EduVora_Cover_Art.jpg
OUTPUT_BASE_DIR=storage/audiobooks
LOG_DIR=logs
